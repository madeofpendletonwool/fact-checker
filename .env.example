# fact-checker environment configuration.
#
# Copy to .env and fill in real values. .env is gitignored — real values are
# never committed. Every variable here is parsed by internal/config; keep the
# two files in sync when adding variables.

# --- Core runtime -----------------------------------------------------------

# Postgres connection string used by the app and the migrator. The default
# matches the docker-compose db published on localhost:5432; adjust the port
# if something else owns 5432 on your machine.
FACTCHECK_DATABASE_URL=postgres://factcheck:factcheck@localhost:5432/factcheck?sslmode=disable

# Host port the compose db is published on (override when 5432 is taken).
FACTCHECK_DB_PORT=5432

# Address the HTTP server listens on (health endpoint now; review and report
# surfaces later).
FACTCHECK_LISTEN_ADDR=:8080

# Host port the compose app is published on (override when 8080 is taken).
FACTCHECK_APP_PORT=8080

# Log level: debug, info, warn, error.
FACTCHECK_LOG_LEVEL=info

# --- AI provider ------------------------------------------------------------

# OpenAI-compatible endpoint; any compliant gateway works.
FACTCHECK_AI_BASE_URL=https://api.openai.com/v1

# API key. Secret — real values only in .env, never committed or logged.
FACTCHECK_AI_API_KEY=

# Per-request timeout for model calls.
FACTCHECK_AI_TIMEOUT=2m

# --- Per-stage models -------------------------------------------------------

FACTCHECK_MODEL_EXTRACT=
FACTCHECK_MODEL_VALIDATE=
FACTCHECK_MODEL_FACTCHECK=
FACTCHECK_MODEL_REVIEW=

# --- Prices, USD per 1M tokens (input/output per stage) ---------------------

FACTCHECK_PRICE_MTOK_EXTRACT_INPUT=0
FACTCHECK_PRICE_MTOK_EXTRACT_OUTPUT=0
FACTCHECK_PRICE_MTOK_VALIDATE_INPUT=0
FACTCHECK_PRICE_MTOK_VALIDATE_OUTPUT=0
FACTCHECK_PRICE_MTOK_FACTCHECK_INPUT=0
FACTCHECK_PRICE_MTOK_FACTCHECK_OUTPUT=0
FACTCHECK_PRICE_MTOK_REVIEW_INPUT=0
FACTCHECK_PRICE_MTOK_REVIEW_OUTPUT=0

# --- Budgets (USD) ----------------------------------------------------------
# A run halts cleanly when a cap is hit. Zero means unset.

FACTCHECK_BUDGET_TOTAL_USD=0
FACTCHECK_BUDGET_PER_RUN_USD=0

# --- Rate limiting ----------------------------------------------------------

# Minimum interval between model requests, global gate.
FACTCHECK_REQUEST_MIN_INTERVAL=500ms

# Optional per-stage overrides; unset stages use the global interval.
FACTCHECK_REQUEST_INTERVAL_EXTRACT=
FACTCHECK_REQUEST_INTERVAL_VALIDATE=
FACTCHECK_REQUEST_INTERVAL_FACTCHECK=
FACTCHECK_REQUEST_INTERVAL_REVIEW=
